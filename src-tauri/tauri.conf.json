{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "0.6.0",
  "identifier": "app.folio.writer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Folio",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; worker-src 'self'"
    }
  },
  "bundle": {
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "resources": [
      "resources/library.sqlite",
      "resources/LIBRARY-NOTICES.txt"
    ],
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "A focused word processor",
    "category": "Productivity",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ]
  }
}
